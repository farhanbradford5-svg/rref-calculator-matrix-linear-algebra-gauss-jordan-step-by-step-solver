# RREF Calculator — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NOT be committed.

# ── Analytics ──────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get this from Google Analytics > Admin > Data Streams > Web Stream Details
NEXT_PUBLIC_GA4_ID=

# ── Search Console Verification ─────────────────────────────────────────────────
# Google Search Console HTML tag verification code (content attribute value only)
# Get this from Search Console > Settings > Ownership Verification > HTML Tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Bing Webmaster Tools ─────────────────────────────────────────────────────────
# Bing Webmaster verification meta content value
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Google AdSense ───────────────────────────────────────────────────────────────
# AdSense Publisher ID (format: pub-XXXXXXXXXXXXXXXX)
# Set after AdSense approval. Also update public/ads.txt with this ID.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ── Site URL ─────────────────────────────────────────────────────────────────────
# Production domain — used for canonical URLs and sitemap generation
NEXT_PUBLIC_SITE_URL=https://rrefmatrixcalc.com

# ── Contact Form ─────────────────────────────────────────────────────────────────
# If you add a contact form backend, put the endpoint or API key here
# CONTACT_FORM_ENDPOINT=
